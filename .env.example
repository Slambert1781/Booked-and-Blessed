# Copy to .env.local for local development. Add the same values in
# Vercel → Project → Settings → Environment Variables for deploys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Used to write the shared gas price cache. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# https://www.eia.gov/opendata/register.php (free). Server only.
EIA_API_KEY=

# Google Cloud → APIs & Services → Credentials. Enable Routes API and Places API (New). Server only.
GOOGLE_MAPS_API_KEY=

# Optional fallback for magic-link redirects, e.g. https://booked-and-blessed.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
